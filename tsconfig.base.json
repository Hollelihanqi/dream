{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@rdeam/vite-plugin-element-plus-theme-builder": [
        "packages/vite-plugin-element-plus-theme-builder/src/index.ts"
      ],
      "@rdeam/pinia-plugin-uni-persist-next": [
        "packages/pinia-plugin-uni-persist-next/src/index.ts"
      ],
      "@rdeam/vue-components-resolver": ["packages/vue-components-resolver/src/index.ts"],
      "@rdeam/utils": ["packages/utils/src/index.ts"]
    }
  }
}
