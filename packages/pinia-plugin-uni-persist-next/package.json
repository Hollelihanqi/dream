{
  "name": "@rdeam/pinia-plugin-uni-persist-next",
  "version": "1.0.1",
  "description": "A Pinia persistence plugin designed for UniApp storage.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "uniapp",
    "pinia",
    "storage",
    "persist",
    "plugin"
  ],
  "author": "lihanqi <1401009231@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hollelihanqi/dream.git",
    "directory": "packages/pinia-plugin-uni-persist-next"
  },
  "bugs": {
    "url": "https://github.com/Hollelihanqi/dream/issues"
  },
  "homepage": "https://github.com/Hollelihanqi/dream/tree/main/packages/pinia-plugin-uni-persist-next#readme",
  "peerDependencies": {
    "pinia": ">=3.0.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.28",
    "pinia": "^3.0.4",
    "vue": "^3.5.26"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "prepublishOnly": "pnpm build"
  }
}
