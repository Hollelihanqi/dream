{
  "name": "@rdeam/utils",
  "version": "0.1.0",
  "description": "Shared utilities for the dream technology stack.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hollelihanqi/dream.git",
    "directory": "packages/utils"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "prepublishOnly": "pnpm build"
  }
}
